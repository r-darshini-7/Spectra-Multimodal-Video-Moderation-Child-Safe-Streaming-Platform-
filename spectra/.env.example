FLASK_SECRET_KEY=
# Email recovery: copy these settings to .env and fill in your provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=spectra_db
UPLOAD_FOLDER=spectra/static/uploads
HLS_OUTPUT_FOLDER=spectra/static/hls
DOWNLOAD_FOLDER=spectra/static/downloads
MAX_CONTENT_LENGTH=2147483648
WHISPER_MODEL=base
YOLO_MODEL=yolo11n.pt
BERT_MODEL=unitary/toxic-bert
CHROMA_PERSIST_DIR=spectra/chroma_db
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
